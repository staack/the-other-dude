# The Other Dude — Traefik dynamic configuration example
#
# This config assumes:
#   - TOD frontend runs on FRONTEND_HOST:3000
#   - TOD API runs on API_HOST:8001
#   - Traefik entrypoints: web (80) and websecure (443)
#
# Replace tod.example.com and upstream addresses with your values.
#
# For Docker-based Traefik, labels can replace this file.
# This example uses file provider for clarity.

http:
  routers:
    # Remote WinBox is served by the API router below (/api/...); no
    # separate xpra router is needed or supported.

    # ── API ─────────────────────────────────────────────────────────
    tod-api:
      rule: "Host(`tod.example.com`) && PathPrefix(`/api/`)"
      entryPoints: [websecure]
      service: tod-api
      middlewares: [security-headers]
      tls:
        certResolver: letsencrypt
      priority: 20

    # ── Frontend (SPA) ──────────────────────────────────────────────
    tod-frontend:
      rule: "Host(`tod.example.com`)"
      entryPoints: [websecure]
      service: tod-frontend
      middlewares: [security-headers]
      tls:
        certResolver: letsencrypt
      priority: 10

  services:
    tod-api:
      loadBalancer:
        servers:
          - url: "http://YOUR_TOD_HOST:8001"

    tod-frontend:
      loadBalancer:
        servers:
          - url: "http://YOUR_TOD_HOST:3000"

  middlewares:
    security-headers:
      headers:
        # Not frameDeny: the Remote WinBox client is framed by the SPA (same origin).
        frameDeny: false
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Frame-Options: "SAMEORIGIN"

# IMPORTANT: Disable Traefik's built-in compression for the API router.
# Remote WinBox WebSocket binary frames pass through it and compression
# corrupts them.
