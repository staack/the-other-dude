# The Other Dude — Caddy reverse proxy example
#
# This config assumes:
#   - TOD frontend runs on FRONTEND_HOST:3000
#   - TOD API runs on API_HOST:8001
#
# Replace tod.example.com and the upstream IPs with your values.
# Caddy handles TLS automatically via Let's Encrypt.

tod.example.com {
    log {
        output file /var/log/caddy/tod.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Remote WinBox (xpra HTML5 client and its WebSocket) is served through
    # the API under /api/...; no separate proxy route to the worker is needed.

    # ── API ───────────────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy http://{$API_HOST:YOUR_TOD_HOST}:8001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            transport http {
                dial_timeout 30s
                response_header_timeout 60s
            }
        }
    }

    # ── Frontend (SPA) ────────────────────────────────────────────────
    handle {
        reverse_proxy http://{$FRONTEND_HOST:YOUR_TOD_HOST}:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
